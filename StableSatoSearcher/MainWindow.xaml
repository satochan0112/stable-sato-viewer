<Window x:Class="StableSatoSearcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StableSatoSearcher"
        mc:Ignorable="d"
        Title="StableSatoSearcher"
        Height="900"
        Width="1450"
        MinHeight="720"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <DockPanel Margin="8">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="ToggleFolderTreePaneButton" Content="フォルダツリー非表示" Width="150" Margin="0,0,16,0" Click="ToggleFolderTreePaneButton_Click" />
            <Button x:Name="SlideShowToggleButton" Content="スライドショー開始（終了はEsc）" Width="190" Margin="0,0,12,0" Click="ToggleSlideShowButton_Click" />
            <CheckBox x:Name="RandomOrderCheckBox" Content="ランダム順" VerticalAlignment="Center" Margin="0,0,18,0" Checked="RandomOrderCheckBox_Changed" Unchecked="RandomOrderCheckBox_Changed" />
            <TextBlock Text="検索履歴" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="SearchHistoryComboBox" Width="260" IsEditable="True" StaysOpenOnEdit="True" SelectionChanged="SearchHistoryComboBox_SelectionChanged" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderTreeColumn" Width="280" MinWidth="180" />
                <ColumnDefinition x:Name="FolderTreeSplitterColumn" Width="5" />
                <ColumnDefinition Width="450" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="FolderTreeGroupBox" Header="フォルダツリー" Grid.Column="0" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,4">
                        <Button Content="画像フォルダ追加" Width="120" Margin="0,0,6,0" Click="AddFolderButton_Click" />
                        <Button Content="選択フォルダ削除" Width="120" Click="RemoveFolderButton_Click" />
                    </StackPanel>
                    <TreeView Grid.Row="1"
                              x:Name="FolderTreeView"
                              Margin="8,4,8,8"
                              ItemsSource="{Binding FolderTreeRoots}"
                              SelectedItemChanged="FolderTreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </GroupBox>

            <GridSplitter x:Name="FolderTreeGridSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#DDDDDD" />

            <Grid Grid.Column="2" Margin="4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="検索" Grid.Row="0" Margin="0,0,0,8">
                    <DockPanel Margin="8" LastChildFill="False">
                        <TextBox x:Name="SearchTextBox" Width="230" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged" />
                        <Button x:Name="SearchExecuteButton" Content="検索実行" Width="86" Margin="8,0,0,0" Click="SearchExecuteButton_Click" />
                        <CheckBox x:Name="RealtimeSearchCheckBox" Content="リアルタイム検索" VerticalAlignment="Center" Margin="12,0,0,0" Checked="RealtimeSearchCheckBox_Changed" Unchecked="RealtimeSearchCheckBox_Changed" />
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="画像一覧（サムネイル）" Grid.Row="1">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="並び順" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="SortByComboBox" Width="100" Margin="0,0,6,0" SelectionChanged="SortOption_SelectionChanged">
                                <ComboBoxItem>ファイル名</ComboBoxItem>
                                <ComboBoxItem IsSelected="True">フォルダ名</ComboBoxItem>
                            </ComboBox>
                            <ComboBox x:Name="SortDirectionComboBox" Width="80" SelectionChanged="SortOption_SelectionChanged">
                                <ComboBoxItem IsSelected="True">昇順</ComboBoxItem>
                                <ComboBoxItem>降順</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 x:Name="ThumbnailListBox"
                                 ItemsSource="{Binding FilteredImages}"
                                 SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                                 SelectionChanged="ThumbnailListBox_SelectionChanged"
                                 MouseDoubleClick="ThumbnailListBox_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="130" Height="150" Margin="4" BorderBrush="#DDDDDD" BorderThickness="1" Padding="4" Background="White">
                                        <Border.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" />
                                                <TextBlock Text="{Binding FolderName}" />
                                            </StackPanel>
                                        </Border.ToolTip>
                                        <StackPanel>
                                            <Image Width="118" Height="110" Stretch="UniformToFill" Source="{Binding Thumbnail}" />
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#DDDDDD" />

            <Grid Grid.Column="4" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="160" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="2*" MinHeight="120" />
                </Grid.RowDefinitions>

                <GroupBox x:Name="PreviewGroupBox" Header="画像プレビュー" Grid.Row="0" Margin="0,0,0,4" Focusable="True" IsTabStop="True" PreviewMouseDown="PreviewGroupBox_PreviewMouseDown">
                    <Grid Margin="8">
                        <Image Stretch="Uniform" Source="{Binding SelectedImage.Preview}" />
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#DDDDDD" />

                <GroupBox x:Name="PropertyGroupBox" Header="画像プロパティ" Grid.Row="2" Margin="0,4,0,0" Focusable="True" IsTabStop="True" PreviewMouseDown="PropertyGroupBox_PreviewMouseDown">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ファイル名" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedImage.FileName}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="フルパス" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedImage.FullPath}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="サイズ" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedImage.FileSizeText}" Margin="0,8,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="更新日時" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedImage.LastWriteTimeText}" Margin="0,8,0,0" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="解像度" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedImage.DimensionText}" Margin="0,8,0,0" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="形式" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedImage.Extension}" Margin="0,8,0,0" />
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
