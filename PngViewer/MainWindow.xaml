<Window x:Class="StableSatoViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stable Sato Viewer" Height="600" Width="1000"
        Background="#1e1e1e" Foreground="#ffffff"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/StableSatoViewer;component/Assets/favicons/favicon.ico">
    <Window.Resources>
    </Window.Resources>
    <DockPanel Background="#1e1e1e" LastChildFill="True">
        <!-- メイン領域を左右に分割 -->
        <Grid Background="#1e1e1e">
            <Grid.ColumnDefinitions>
                <!-- 左端: フォルダツリー -->
                <ColumnDefinition Width="260" />
                <!-- ツリーと画像のスプリッター -->
                <ColumnDefinition Width="6" />
                <!-- 左側: 画像表示領域 -->
                <ColumnDefinition Width="*" />
                <!-- 画像と右パネルのスプリッター -->
                <ColumnDefinition Width="6" />
                <!-- 右側: テキスト表示領域 -->
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- フローティングプロンプト（モード: 画像最大化時に表示）- 画像上に重ねる -->
            <Border x:Name="floatingPromptBorder" Grid.Column="2" Visibility="Collapsed" Width="320" Height="420" Background="#80000000" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,20,0" Panel.ZIndex="3500">
                <DataGrid x:Name="floatingPromptGrid" Background="Transparent" Foreground="#ffffff"
                          BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          CanUserSortColumns="False" HeadersVisibility="None"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ffffff" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="DataGrid.SelectedForeground" Color="#ffffff" />
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#ffffff"/>
                            <Setter Property="MinHeight" Value="25"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="5,3,5,3"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding Value}" IsReadOnly="True" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Padding" Value="5,3,5,3"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="2" Opacity="0.8"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- フロート表示ボタン -->
            <!-- 右上のフローティングコントロール（画像領域を覆わないよう領域を限定） -->
            <Canvas Grid.Column="2" Background="Transparent" IsHitTestVisible="True" Panel.ZIndex="3000" HorizontalAlignment="Right" VerticalAlignment="Top" Width="259" Height="56" Margin="0,10,10,0">
                <!-- 履歴ボタン（時計アイコン） -->
                <Button x:Name="historyButton" Content="&#xE81C;" Width="36" Height="36"
                        Canvas.Left="16" Canvas.Top="10" FontFamily="Segoe MDL2 Assets"
                        Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0"
                        FontSize="16" Cursor="Hand" Click="HistoryButton_Click" ToolTip="History" />

                <!-- お気に入りボタン（★） -->
                <Button x:Name="favoritesButton" Content="&#xE734;" Width="36" Height="36"
                        Canvas.Left="62" Canvas.Top="10" FontFamily="Segoe MDL2 Assets"
                        Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0"
                        FontSize="16" Cursor="Hand" Click="FavoritesButton_Click" ToolTip="Favorites" />

                <!-- レイアウトトグル（通常/フロート/非表示） -->
                <Button x:Name="toggleButton" Content="&#xE946;" Width="36" Height="36"
                        Canvas.Left="120" Canvas.Top="10" FontFamily="Segoe MDL2 Assets"
                        Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0"
                        FontSize="16" Cursor="Hand" />

                <!-- fullScreenButton -->
                <ToggleButton x:Name="fullScreenToggle" Width="36" Height="36" ToolTip="全画面切替"
                              Canvas.Left="170" Canvas.Top="10" Cursor="Hand"
                              Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                    <TextBlock x:Name="MaxGlyph" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE740;" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RestoreGlyph" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE73F;" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="MaxGlyph" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="RestoreGlyph" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#a0c0ff"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#505050"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- トースト通知 -->
                <Border x:Name="toastBorder" Visibility="Collapsed" Canvas.Left="10" Canvas.Top="50"
                        Background="#333" CornerRadius="4" Padding="8" Opacity="0.95" Panel.ZIndex="200">
                    <TextBlock x:Name="toastText" Foreground="#ffffff" FontSize="12">Copied to clipboard!</TextBlock>
                </Border>
            </Canvas>

            <!-- フロート表示ボタン -->
            <!-- 右上のフローティングコントロール（画像領域を覆わないよう領域を限定） -->
            <Canvas Grid.Column="2" Background="Transparent" IsHitTestVisible="True" Panel.ZIndex="3000" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="56" Margin="0,10,0,0">
                <!-- フォルダツリー表示切替 -->
                <Button x:Name="treeToggleButton" Content="&#xEA37;" Width="36" Height="36"
                        Canvas.Left="20" Canvas.Top="10" FontFamily="Segoe MDL2 Assets"
                        Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0"
                        FontSize="16" Cursor="Hand" ToolTip="Toggle folders" />
            </Canvas>
            <!-- 左側: PNG画像 -->
            <Border x:Name="imageBorder" Grid.Column="2" Background="#000000" Cursor="Hand" AllowDrop="True" PreviewDragOver="ImageBorder_PreviewDragOver" Drop="ImageBorder_Drop">
                <Grid>
                    <!-- 固定サイズ（300x300）のグレースケール背景画像、中央表示でクリックを透過 -->
                    <Image Source="pack://application:,,,/StableSatoViewer;component/Assets/stablesatoviewer_gs.png"
                           Width="300" Height="300" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Opacity="1"/>

                    <!-- 表示される実際の画像（上に重なる） -->
                    <Image Name="imageBox" Stretch="Uniform" />

                    <!-- 画像領域内の下中央ナビゲーションボタン（オーバーレイ） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Panel.ZIndex="2000" IsHitTestVisible="True" Visibility="Visible">
                        <!-- File open button moved here, left of prevImageButton -->
                        <!-- 廃止: OSのフォルダー選択ダイアログは使用しないため削除 -->
                        <Button x:Name="openInExplorerButton" Width="44" Height="44" Margin="6,0" FontFamily="Segoe MDL2 Assets" FontSize="18" Content="&#xE838;"
                                Background="#AA2d2d2d" Foreground="#ffffff" BorderThickness="0" Cursor="Hand" Click="OpenInExplorerButton_Click" Panel.ZIndex="2001" Visibility="Visible"/>
                        <Button x:Name="prevImageButton" Width="44" Height="44" Margin="6,0" FontFamily="Segoe MDL2 Assets" FontSize="18" Content="&#xE76B;"
                                Background="#AA2d2d2d" Foreground="#ffffff" BorderThickness="0" Cursor="Hand" Click="PrevImageButton_Click" Panel.ZIndex="2001" Visibility="Visible"/>
                        <Button x:Name="nextImageButton" Width="44" Height="44" Margin="6,0" FontFamily="Segoe MDL2 Assets" FontSize="18" Content="&#xE76C;"
                                Background="#AA2d2d2d" Foreground="#ffffff" BorderThickness="0" Cursor="Hand" Click="NextImageButton_Click" Panel.ZIndex="2001" Visibility="Visible"/>
                    </StackPanel>

                    <!-- Favorites popup (moved here so DockPanel's last child remains Grid) -->
                    <Popup x:Name="favoritesPopup" PlacementTarget="{Binding ElementName=favoritesButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#2d2d2d" BorderBrush="#404040" BorderThickness="1" CornerRadius="4" Padding="6" Width="520" Height="320">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <Button x:Name="addFavoriteButton" Content="ブックマークに追加" Margin="0,0,6,0" Click="AddFavoriteButton_Click"/>
                                    <Button x:Name="removeAllFavoritesButton" Content="すべてのブックマークを削除" Margin="0,0,6,0" Click="RemoveAllFavoritesButton_Click"/>
                                    <Button x:Name="editFavoritesButton" Content="ブックマークの編集" Click="EditFavoritesButton_Click"/>
                                </StackPanel>
                                <DataGrid x:Name="favoritesListBox" Grid.Row="1" Background="#1e1e1e" Foreground="#ffffff" 
                                          BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          CanUserSortColumns="False" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#303030" VerticalScrollBarVisibility="Auto" MouseDoubleClick="FavoritesListBox_MouseDoubleClick">
                                    <DataGrid.Resources>
                                        <SolidColorBrush x:Key="DataGrid.SelectedForeground" Color="#ffffff" />
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#ffffff"/>
                                            <Setter Property="MinHeight" Value="70"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#303030"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#404040"/>
                                                    <Setter Property="Foreground" Value="#ffffff"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#404040"/>
                                            <Setter Property="Foreground" Value="#ffffff"/>
                                            <Setter Property="Padding" Value="5"/>
                                            <Setter Property="BorderBrush" Value="#505050"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="5,3,5,3"/>
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#ffffff"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="サムネイル" Width="70" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#505050" BorderThickness="1" CornerRadius="2" Background="#1e1e1e" Padding="2" MaxWidth="64" MaxHeight="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#ffffff"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Popup>

                    <!-- 履歴ポップアップ -->
                    <Popup x:Name="historyPopup" PlacementTarget="{Binding ElementName=historyButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#2d2d2d" BorderBrush="#404040" BorderThickness="1" CornerRadius="4" Padding="6" Width="520" Height="320">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <Button x:Name="clearAllHistoryButton" Content="履歴をすべてクリア" Margin="0,0,6,0" Click="ClearAllHistoryButton_Click"/>
                                </StackPanel>
                                <DataGrid x:Name="historyListBox" Grid.Row="1" Background="#1e1e1e" Foreground="#ffffff" 
                                          BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          CanUserSortColumns="False" MouseDoubleClick="HistoryListBox_MouseDoubleClick"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#404040">
                                    <DataGrid.Resources>
                                        <SolidColorBrush x:Key="DataGrid.SelectedForeground" Color="#ffffff" />
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="#1e1e1e"/>
                                            <Setter Property="Foreground" Value="#ffffff"/>
                                            <Setter Property="MinHeight" Value="28"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#404040"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#505050"/>
                                                    <Setter Property="Foreground" Value="#ffffff"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#404040"/>
                                            <Setter Property="Foreground" Value="#ffffff"/>
                                            <Setter Property="Padding" Value="5"/>
                                            <Setter Property="BorderBrush" Value="#505050"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="5,3,5,3"/>
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#ffffff"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="サムネイル" Width="70" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#505050" BorderThickness="1" CornerRadius="2" Background="#1e1e1e" Padding="2" MaxWidth="64" MaxHeight="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#ffffff"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="開いた日時" Binding="{Binding OpenedAtString}" Width="150" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#a0c0ff"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- カラム間の幅をドラッグで変更できるようにする -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                           Background="#404040" Cursor="SizeWE" Focusable="False"
                           IsTabStop="False"
                           KeyboardNavigation.IsTabStop="False"/>

            <!-- 右側: tEXt表示エリア -->
            <Grid Grid.Column="4" Background="#2d2d2d">
                <Grid.RowDefinitions>
                    <!-- Prompt -->
                    <RowDefinition Height="*" />
                    <!-- Negative Prompt -->
                    <RowDefinition Height="*" />
                    <!-- Infos -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Prompt -->
                <Border Grid.Row="0" BorderBrush="#404040" BorderThickness="0,0,0,0">
                    <Grid Background="#2d2d2d">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- ヘッダー: Prompt タイトルとトグルボタン -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Prompt" Foreground="#60a0ff" FontWeight="Bold" Padding="10,8,10,5" FontSize="11" VerticalAlignment="Center"/>
                            <Button x:Name="parametersToggleButton" Grid.Column="1" Content="&#xE71D;" Width="24" Height="24" Margin="0,6,8,6" VerticalAlignment="Center"
                                    Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0" FontFamily="Segoe MDL2 Assets" 
                                    FontSize="11" Cursor="Hand" />
                        </Grid>

                        <!-- コンテンツ領域: DataGrid と TextBox（表示切替） -->
                        <Grid Grid.Row="1">
                            <DataGrid Name="parametersGrid" Background="#1e1e1e" Foreground="#e0e0e0"
                                      BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                      CanUserSortColumns="False" HeadersVisibility="None"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#404040"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="DataGrid.SelectedForeground" Color="#e0e0e0" />
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="Foreground" Value="#e0e0e0"/>
                                        <Setter Property="MinHeight" Value="25"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="5,3,5,3"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="" Binding="{Binding Value}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Padding" Value="5,3,5,3"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Raw text view for full prompt; hidden by default -->
                            <TextBox x:Name="parametersTextBox" Visibility="Collapsed" Background="#1e1e1e" Foreground="#e0e0e0"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0" Padding="6" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Negative Prompt -->
                <Border Grid.Row="1" BorderBrush="#404040" BorderThickness="0,1,0,0">
                    <Grid Background="#2d2d2d">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- ヘッダー: Negative Prompt タイトルとトグルボタン -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Negative Prompt" Foreground="#60a0ff" FontWeight="Bold" Padding="10,8,10,5" FontSize="11" VerticalAlignment="Center" />
                            <Button x:Name="negativeToggleButton" Grid.Column="1" Content="&#xE71D;" Width="24" Height="24" Margin="0,6,8,6" VerticalAlignment="Center"
                                    Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="11" Cursor="Hand" />
                        </Grid>

                        <!-- コンテンツ領域: DataGrid と TextBox（表示切替） -->
                        <Grid Grid.Row="1">
                            <DataGrid Name="negativePromptGrid" Background="#1e1e1e" Foreground="#e0e0e0"
                                      BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                      CanUserSortColumns="False" HeadersVisibility="None"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#404040"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="DataGrid.SelectedForeground" Color="#e0e0e0" />
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="Foreground" Value="#e0e0e0"/>
                                        <Setter Property="MinHeight" Value="25"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="5,3,5,3"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="" Binding="{Binding Value}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Padding" Value="5,3,5,3"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Raw text view for negative prompt; hidden by default -->
                            <TextBox x:Name="negativePromptTextBox" Visibility="Collapsed" Background="#1e1e1e" Foreground="#e0e0e0"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0" Padding="6" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Infos -->
                <Border Grid.Row="2" BorderBrush="#404040" BorderThickness="0,1,0,0">
                    <Grid Background="#2d2d2d">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- ヘッダー: Infos タイトルとトグルボタン -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Infos" Foreground="#60a0ff" FontWeight="Bold" Padding="10,8,10,5" FontSize="11" VerticalAlignment="Center"/>
                            <Button x:Name="stepsToggleButton" Grid.Column="1" Content="&#xE71D;" Width="24" Height="24" Margin="0,6,8,6" VerticalAlignment="Center"
                                    Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="11" Cursor="Hand" />
                        </Grid>

                        <!-- コンテンツ領域: steps DataGrid と生の TextBox -->
                        <Grid Grid.Row="1">
                            <DataGrid Name="stepsGrid" Background="#1e1e1e" Foreground="#e0e0e0"
                                      BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                      CanUserSortColumns="False" HeadersVisibility="None"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#404040"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="DataGrid.SelectedForeground" Color="#e0e0e0" />
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="Foreground" Value="#e0e0e0"/>
                                        <Setter Property="MinHeight" Value="25"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="5,3,5,3"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                                <Setter Property="Foreground" Value="#60a0ff"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="5,8,5,8"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                <Setter Property="BorderBrush" Value="#404040"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="5,3,5,3"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                                <Setter Property="Foreground" Value="#60a0ff"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="5,8,5,8"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#404040"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Padding" Value="5,3,5,3"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Raw text view for steps; hidden by default -->
                            <TextBox x:Name="stepsTextBox" Visibility="Collapsed" Background="#1e1e1e" Foreground="#e0e0e0"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0" Padding="6" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 左端: フォルダツリー + ファイル一覧 -->
            <Border x:Name="treeBorder" Grid.Column="0" Grid.Row="0" Background="#1e1e1e" BorderBrush="#2d2d2d" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TreeView x:Name="folderTreeView" Grid.Row="0" Background="#1e1e1e" Foreground="#e0e0e0" BorderThickness="0" SelectedItemChanged="FolderTreeView_SelectedItemChanged" MinHeight="80">
                        <!-- ItemContainerStyle to ensure readable text -->
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#e0e0e0" />
                                <Setter Property="FontSize" Value="12" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <!-- ツリーとファイル一覧の間に水平スプリッターを追加 -->
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="#404040" Cursor="SizeNS" Focusable="False" IsTabStop="False" ShowsPreview="True"/>

                    <Border Grid.Row="2" BorderThickness="1,0,0,0" BorderBrush="#2d2d2d" Background="#171717" MinHeight="80">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- フィルター入力欄 -->
                            <Border Grid.Row="0" BorderBrush="#404040" BorderThickness="0,0,0,1" Background="#1e1e1e" Padding="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="filterTextBox" Grid.Column="0" Background="#2d2d2d" Foreground="#e0e0e0"
                                             BorderThickness="1" BorderBrush="#404040" Padding="4" VerticalAlignment="Center" />
                                    <Button x:Name="filterButton" Grid.Column="1" Content="&#xE71C;" Background="#404040" Foreground="#ffffff"
                                            BorderThickness="0" Margin="4,0,0,0" Padding="8,4" FontFamily="Segoe MDL2 Assets" FontSize="11" Cursor="Hand" Click="FilterButton_Click" />
                                    <Button x:Name="clearFilterButton" Grid.Column="2" Content="&#xE894;" Background="#404040" Foreground="#ffffff"
                                            BorderThickness="0" Margin="4,0,0,0" Padding="8,4" FontFamily="Segoe MDL2 Assets" FontSize="11"  Cursor="Hand" Click="ClearFilterButton_Click" />
                                </Grid>
                            </Border>

                            <!-- ファイルリスト -->
                            <ListBox x:Name="folderFilesListBox" Grid.Row="1" Background="#171717" Foreground="#e0e0e0" BorderThickness="0" 
                                     MouseDoubleClick="FolderFilesListBox_MouseDoubleClick" SelectionChanged="FolderFilesListBox_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#e0e0e0" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2d2d2d" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#60a0ff" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- スプリッター: ツリーと画像の間 -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="#404040" Cursor="SizeWE" Focusable="False"
                          IsTabStop="False" KeyboardNavigation.IsTabStop="False"/>
        </Grid>
    </DockPanel>
</Window>