<Window x:Class="StableSatoViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stable Sato Viewer" Height="600" Width="1000"
        Background="#1e1e1e" Foreground="#ffffff"
        ResizeMode="CanResize">
    <Window.Resources>
    </Window.Resources>
    <DockPanel Background="#1e1e1e">
        <!-- メイン領域を左右に分割 -->
        <Grid Background="#1e1e1e">
            <Grid.ColumnDefinitions>
                <!-- 左側: 画像表示領域 -->
                <ColumnDefinition Width="*" />
                <!-- グリッドスプリッター用 -->
                <ColumnDefinition Width="5" />
                <!-- 右側: テキスト表示領域 -->
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- フロート表示ボタン -->
            <Canvas Background="Transparent" IsHitTestVisible="True" Panel.ZIndex="100">
                <Button Name="toggleButton" Content="tEXt表示/非表示" Width="150" Height="30"
                    Canvas.Right="160" Canvas.Top="10"
                    Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0"
                    FontSize="12" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#505050"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Name="fullScreenButton" Content="全画面" Width="150" Height="30"
                    Canvas.Right="10" Canvas.Top="10"
                    Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0"
                    FontSize="12" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#505050"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Canvas>
            <!-- 左側: PNG画像 -->
            <Border Grid.Column="0" Background="#000000">
                <Image Name="imageBox" Stretch="Uniform" />
            </Border>

            <!-- カラム間の幅をドラッグで変更できるようにする -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="#404040" Cursor="SizeWE" Focusable="False"
                          IsTabStop="False"
                          KeyboardNavigation.IsTabStop="False"/>

            <!-- 右側: tEXt表示エリア -->
            <Grid Grid.Column="2" Background="#2d2d2d">
                <Grid.RowDefinitions>
                    <!-- Prompt -->
                    <RowDefinition Height="*" />
                    <!-- Negative Prompt -->
                    <RowDefinition Height="*" />
                    <!-- Infos -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Prompt -->
                <Border Grid.Row="0" BorderBrush="#404040" BorderThickness="0,0,0,0">
                    <Grid Background="#2d2d2d">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Prompt" Foreground="#60a0ff" FontWeight="Bold" Padding="10,8,10,5" FontSize="11"/>
                        <DataGrid Name="parametersGrid" Grid.Row="1" Background="#1e1e1e" Foreground="#e0e0e0"
                                  BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  CanUserSortColumns="False" HeadersVisibility="None"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#404040"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#1e1e1e"/>
                                    <Setter Property="Foreground" Value="#e0e0e0"/>
                                    <Setter Property="MinHeight" Value="25"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2d2d2d"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="#1e1e1e"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="5,3,5,3"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="" Binding="{Binding Value}" IsReadOnly="True" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="5,3,5,3"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Negative Prompt -->
                <Border Grid.Row="1" BorderBrush="#404040" BorderThickness="0,1,0,0">
                    <Grid Background="#2d2d2d">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Negative Prompt" Foreground="#60a0ff" FontWeight="Bold" Padding="10,8,10,5" FontSize="11"/>
                        <DataGrid Name="negativePromptGrid" Grid.Row="1" Background="#1e1e1e" Foreground="#e0e0e0"
                                  BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  CanUserSortColumns="False" HeadersVisibility="None"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#404040"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#1e1e1e"/>
                                    <Setter Property="Foreground" Value="#e0e0e0"/>
                                    <Setter Property="MinHeight" Value="25"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2d2d2d"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="#1e1e1e"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="5,3,5,3"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="" Binding="{Binding Value}" IsReadOnly="True" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="5,3,5,3"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Infos -->
                <Border Grid.Row="2" BorderBrush="#404040" BorderThickness="0,1,0,0">
                    <Grid Background="#2d2d2d">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Infos" Foreground="#60a0ff" FontWeight="Bold" Padding="10,8,10,5" FontSize="11"/>
                        <DataGrid Name="stepsGrid" Grid.Row="1" Background="#1e1e1e" Foreground="#e0e0e0"
                                  BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  CanUserSortColumns="False" HeadersVisibility="None"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#404040"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#1e1e1e"/>
                                    <Setter Property="Foreground" Value="#e0e0e0"/>
                                    <Setter Property="MinHeight" Value="25"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2d2d2d"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#404040"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="#1e1e1e"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="5,3,5,3"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="*">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#2d2d2d"/>
                                            <Setter Property="Foreground" Value="#60a0ff"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="5,8,5,8"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="BorderBrush" Value="#404040"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="5,3,5,3"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" IsReadOnly="True" Width="*">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#2d2d2d"/>
                                            <Setter Property="Foreground" Value="#60a0ff"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="5,8,5,8"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#404040"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="5,3,5,3"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </DockPanel>
</Window>