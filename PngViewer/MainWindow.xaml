<Window x:Class="StableSatoViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stable Sato Viewer" Height="600" Width="1000"
        Background="#1e1e1e" Foreground="#ffffff"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/StableSatoViewer;component/Assets/favicons/favicon.ico">
    <Window.Resources>
    </Window.Resources>
    <DockPanel Background="#1e1e1e" LastChildFill="True">
        <!-- メイン領域を左右に分割 -->
        <Grid Background="#1e1e1e">
            <Grid.ColumnDefinitions>
                <!-- 左側: 画像表示領域 -->
                <ColumnDefinition Width="*" />
                <!-- グリッドスプリッター用 -->
                <ColumnDefinition Width="5" />
                <!-- 右側: テキスト表示領域 -->
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- フローティングプロンプト（モード: 画像最大化時に表示）- 画像上に重ねる -->
            <Border x:Name="floatingPromptBorder" Grid.Column="0" Visibility="Collapsed" Width="320" Height="420" Background="#80000000" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,20,0" Panel.ZIndex="3500">
                <DataGrid x:Name="floatingPromptGrid" Background="Transparent" Foreground="#ffffff"
                          BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          CanUserSortColumns="False" HeadersVisibility="None"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ffffff" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="DataGrid.SelectedForeground" Color="#ffffff" />
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#ffffff"/>
                            <Setter Property="MinHeight" Value="25"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="5,3,5,3"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding Value}" IsReadOnly="True" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Padding" Value="5,3,5,3"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="2" Opacity="0.8"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- フロート表示ボタン -->
            <!-- 右上のフローティングコントロール（画像領域を覆わないよう領域を限定） -->
            <Canvas Background="Transparent" IsHitTestVisible="True" Panel.ZIndex="3000" HorizontalAlignment="Right" VerticalAlignment="Top" Width="213" Height="56" Margin="0,10,10,0">
                <!-- お気に入りボタン（★） -->
                <Button x:Name="favoritesButton" Content="&#xE734;" Width="36" Height="36"
                        Canvas.Left="10" Canvas.Top="10" FontFamily="Segoe MDL2 Assets"
                        Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0"
                        FontSize="16" Cursor="Hand" Click="FavoritesButton_Click" ToolTip="Favorites" />

                <!-- 画像選択を再表示するボタン（トップバーの左） -->
                <Button x:Name="bookmarkButton" Content="&#xE718;" Width="36" Height="36"
                        Canvas.Left="56" Canvas.Top="10" FontFamily="Segoe MDL2 Assets"
                        Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0"
                        FontSize="16" Cursor="Hand" Click="OpenBookmarkButton_Click" ToolTip="Bookmark" />

                <!-- レイアウトトグル（通常/フロート/非表示） -->
                <Button x:Name="toggleButton" Content="&#xE946;" Width="36" Height="36"
                        Canvas.Left="122" Canvas.Top="10" FontFamily="Segoe MDL2 Assets"
                        Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0"
                        FontSize="16" Cursor="Hand" />

                <!-- fullScreenButton -->
                <ToggleButton x:Name="fullScreenToggle" Width="36" Height="36" ToolTip="全画面切替"
                              Canvas.Left="168" Canvas.Top="10" Cursor="Hand"
                              Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                    <TextBlock x:Name="MaxGlyph" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE740;" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RestoreGlyph" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE73F;" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="MaxGlyph" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="RestoreGlyph" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#404040"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#505050"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- トースト通知 -->
                <Border x:Name="toastBorder" Visibility="Collapsed" Canvas.Left="10" Canvas.Top="50"
                        Background="#333" CornerRadius="4" Padding="8" Opacity="0.95" Panel.ZIndex="200">
                    <TextBlock x:Name="toastText" Foreground="#ffffff" FontSize="12">Copied to clipboard!</TextBlock>
                </Border>
            </Canvas>
            <!-- 左側: PNG画像 -->
            <Border x:Name="imageBorder" Grid.Column="0" Background="#000000" Cursor="Hand">
                <Grid>
                    <!-- 固定サイズ（300x300）のグレースケール背景画像、中央表示でクリックを透過 -->
                    <Image Source="pack://application:,,,/StableSatoViewer;component/Assets/stablesatoviewer_gs.png"
                           Width="300" Height="300" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Opacity="1"/>

                    <!-- 表示される実際の画像（上に重なる） -->
                    <Image Name="imageBox" Stretch="Uniform" />

                    <!-- 画像領域内の下中央ナビゲーションボタン（オーバーレイ） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Panel.ZIndex="2000" IsHitTestVisible="True" Visibility="Visible">
                        <!-- File open button moved here, left of prevImageButton -->
                        <Button x:Name="openFilesButton" Width="44" Height="44" Margin="6,0" FontFamily="Segoe MDL2 Assets" FontSize="18" Content="&#xEC50;"
                                Background="#AA2d2d2d" Foreground="#ffffff" BorderThickness="0" Cursor="Hand" Click="OpenFilesButton_Click" Panel.ZIndex="2001" Visibility="Visible"/>
                        <Button x:Name="prevImageButton" Width="44" Height="44" Margin="6,0" FontFamily="Segoe MDL2 Assets" FontSize="18" Content="&#xE76B;"
                                Background="#AA2d2d2d" Foreground="#ffffff" BorderThickness="0" Cursor="Hand" Click="PrevImageButton_Click" Panel.ZIndex="2001" Visibility="Visible"/>
                        <Button x:Name="nextImageButton" Width="44" Height="44" Margin="6,0" FontFamily="Segoe MDL2 Assets" FontSize="18" Content="&#xE76C;"
                                Background="#AA2d2d2d" Foreground="#ffffff" BorderThickness="0" Cursor="Hand" Click="NextImageButton_Click" Panel.ZIndex="2001" Visibility="Visible"/>
                    </StackPanel>

                    <!-- Favorites popup (moved here so DockPanel's last child remains Grid) -->
                    <Popup x:Name="favoritesPopup" PlacementTarget="{Binding ElementName=favoritesButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#2d2d2d" BorderBrush="#404040" BorderThickness="1" CornerRadius="4" Padding="6" Width="520" Height="320">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <Button x:Name="addFavoriteButton" Content="ブックマークに追加" Margin="0,0,6,0" Click="AddFavoriteButton_Click"/>
                                    <Button x:Name="removeAllFavoritesButton" Content="すべてのブックマークを削除" Margin="0,0,6,0" Click="RemoveAllFavoritesButton_Click"/>
                                    <Button x:Name="editFavoritesButton" Content="ブックマークの編集" Click="EditFavoritesButton_Click"/>
                                </StackPanel>
                                <ListBox x:Name="favoritesListBox" Grid.Row="1" Background="#1e1e1e" Foreground="#e0e0e0" BorderThickness="0" MouseDoubleClick="FavoritesListBox_MouseDoubleClick"/>
                            </Grid>
                        </Border>
                    </Popup>
                 </Grid>
             </Border>

            <!-- カラム間の幅をドラッグで変更できるようにする -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="#404040" Cursor="SizeWE" Focusable="False"
                          IsTabStop="False"
                          KeyboardNavigation.IsTabStop="False"/>

            <!-- 右側: tEXt表示エリア -->
            <Grid Grid.Column="2" Background="#2d2d2d">
                <Grid.RowDefinitions>
                    <!-- Prompt -->
                    <RowDefinition Height="*" />
                    <!-- Negative Prompt -->
                    <RowDefinition Height="*" />
                    <!-- Infos -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Prompt -->
                <Border Grid.Row="0" BorderBrush="#404040" BorderThickness="0,0,0,0">
                    <Grid Background="#2d2d2d">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- ヘッダー: Prompt タイトルとトグルボタン -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Prompt" Foreground="#60a0ff" FontWeight="Bold" Padding="10,8,10,5" FontSize="11" VerticalAlignment="Center"/>
                            <Button x:Name="parametersToggleButton" Grid.Column="1" Content="&#xE71D;" Width="24" Height="24" Margin="0,6,8,6" VerticalAlignment="Center"
                                    Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0" FontFamily="Segoe MDL2 Assets" 
                                    FontSize="11" Cursor="Hand" />
                        </Grid>

                        <!-- コンテンツ領域: DataGrid と TextBox（表示切替） -->
                        <Grid Grid.Row="1">
                            <DataGrid Name="parametersGrid" Background="#1e1e1e" Foreground="#e0e0e0"
                                      BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                      CanUserSortColumns="False" HeadersVisibility="None"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#404040"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="DataGrid.SelectedForeground" Color="#e0e0e0" />
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="Foreground" Value="#e0e0e0"/>
                                        <Setter Property="MinHeight" Value="25"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="5,3,5,3"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="" Binding="{Binding Value}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Padding" Value="5,3,5,3"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Raw text view for full prompt; hidden by default -->
                            <TextBox x:Name="parametersTextBox" Visibility="Collapsed" Background="#1e1e1e" Foreground="#e0e0e0"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0" Padding="6" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Negative Prompt -->
                <Border Grid.Row="1" BorderBrush="#404040" BorderThickness="0,1,0,0">
                    <Grid Background="#2d2d2d">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- ヘッダー: Negative Prompt タイトルとトグルボタン -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Negative Prompt" Foreground="#60a0ff" FontWeight="Bold" Padding="10,8,10,5" FontSize="11" VerticalAlignment="Center" />
                            <Button x:Name="negativeToggleButton" Grid.Column="1" Content="&#xE71D;" Width="24" Height="24" Margin="0,6,8,6" VerticalAlignment="Center"
                                    Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="11" Cursor="Hand" />
                        </Grid>

                        <!-- コンテンツ領域: DataGrid と TextBox（表示切替） -->
                        <Grid Grid.Row="1">
                            <DataGrid Name="negativePromptGrid" Background="#1e1e1e" Foreground="#e0e0e0"
                                      BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                      CanUserSortColumns="False" HeadersVisibility="None"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#404040"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="DataGrid.SelectedForeground" Color="#e0e0e0" />
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="Foreground" Value="#e0e0e0"/>
                                        <Setter Property="MinHeight" Value="25"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="5,3,5,3"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="" Binding="{Binding Value}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Padding" Value="5,3,5,3"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Raw text view for negative prompt; hidden by default -->
                            <TextBox x:Name="negativePromptTextBox" Visibility="Collapsed" Background="#1e1e1e" Foreground="#e0e0e0"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0" Padding="6" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Infos -->
                <Border Grid.Row="2" BorderBrush="#404040" BorderThickness="0,1,0,0">
                    <Grid Background="#2d2d2d">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- ヘッダー: Infos タイトルとトグルボタン -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Infos" Foreground="#60a0ff" FontWeight="Bold" Padding="10,8,10,5" FontSize="11" VerticalAlignment="Center"/>
                            <Button x:Name="stepsToggleButton" Grid.Column="1" Content="&#xE71D;" Width="24" Height="24" Margin="0,6,8,6" VerticalAlignment="Center"
                                    Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="11" Cursor="Hand" />
                        </Grid>

                        <!-- コンテンツ領域: steps DataGrid と生の TextBox -->
                        <Grid Grid.Row="1">
                            <DataGrid Name="stepsGrid" Background="#1e1e1e" Foreground="#e0e0e0"
                                      BorderThickness="0" RowHeaderWidth="0" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                      CanUserSortColumns="False" HeadersVisibility="None"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#404040"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="DataGrid.SelectedForeground" Color="#e0e0e0" />
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="Foreground" Value="#e0e0e0"/>
                                        <Setter Property="MinHeight" Value="25"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="5,3,5,3"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                                <Setter Property="Foreground" Value="#60a0ff"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="5,8,5,8"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                <Setter Property="BorderBrush" Value="#404040"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="5,3,5,3"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                                <Setter Property="Foreground" Value="#60a0ff"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="5,8,5,8"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#404040"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Padding" Value="5,3,5,3"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Raw text view for steps; hidden by default -->
                            <TextBox x:Name="stepsTextBox" Visibility="Collapsed" Background="#1e1e1e" Foreground="#e0e0e0"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0" Padding="6" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        
     </DockPanel>
</Window>