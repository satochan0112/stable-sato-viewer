<Window x:Class="StableSatoViewer.FilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open with filter" Height="114" Width="420" WindowStartupLocation="CenterOwner" Background="#1e1e1e" Foreground="#e0e0e0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Prompt contains:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="promptTextBox" Width="300" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right">
            <Button x:Name="okButton" Content="OK" Width="90" Margin="0,0,8,0" Click="OkButton_Click" />
            <Button x:Name="cancelButton" Content="Cancel" Width="90" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>